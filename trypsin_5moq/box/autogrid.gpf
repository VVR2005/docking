# AD4 grid maps for Vina --scoring ad4
npts 54 54 54
gridfld receptor.maps.fld
spacing 0.375
receptor_types A C N NA OA HD
ligand_types A C N HD
gridcenter -1.75 -14.74 -16.92
A map receptor.A.map
C map receptor.C.map
N map receptor.N.map
HD map receptor.HD.map
elecmap receptor.e.map
dsolvmap receptor.d.map
dielectric -0.1465
